# Copy to .env and fill in. Never commit .env.
# Only PUBLIC (publishable/anon) values belong in the app. The service-role key lives ONLY in
# Supabase Edge Function secrets – never here.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
